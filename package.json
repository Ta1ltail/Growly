{
  "name": "project_101-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "shared",
    "mobile"
  ],
  "overrides": {
    "react-native-safe-area-context": "5.7.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "build:shared": "npm run build --workspace=shared",
    "test": "npm run test --workspace=shared && npm run test --workspace=web",
    "test:shared": "npm run test --workspace=shared",
    "test:web": "npm run test --workspace=web",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=web"
  },
  "devDependencies": {
    "eas-cli": "^20.5.1"
  }
}
